# Android / Gradle
.gradle/
.idea/
*.iml
local.properties
.cxx/
.externalNativeBuild/
captures/
app/build/
build/
*.apk
*.aab
*.ap_
*.dex

# Native C++ (Conan / CMake)
# One build root, split inside by target and build type: build/<target>/<BuildType>.
# Conan and cmake write absolute paths into their caches, so nothing under it is portable.
app/src/main/cpp/build/
app/src/main/cpp/CMakeUserPresets.json
app/src/main/cpp/CMakePresets.json
app/src/main/cpp/conan_toolchain.cmake
app/src/main/cpp/sbom.json
# Conan environment scripts (VirtualBuildEnv/VirtualRunEnv)
app/src/main/cpp/conanbuild*.sh
app/src/main/cpp/conanrun*.sh
app/src/main/cpp/deactivate_conan*.sh
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/compile_commands.json

# Generated protobuf bindings (scripts/generate_proto_python.sh)
scripts/proto/*
scripts/vis/proto/*

# Packaged / copied native libs (built by scripts/build_project.sh or gradle)
app/libs/
app/src/main/jniLibs/
*.so

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# MetaDrive / bag dump dirs (sim.main --out-dir, default "run")
scripts/run/
scripts/run_*/

# Run and analysis exports: sim.eval --csv/--json/--plot, bag_*.py, PlotJuggler.
# Keep curated plots under docs/figures/; do not commit ad-hoc analysis dumps.
scripts/*.csv
scripts/*.json
scripts/*.png
scripts/*.npz

# Bag sessions pulled from the phone (scripts/pull_bags.sh) — never commit these
adas_logs/

# Large ONNX downloads (models/ is populated by scripts/install_dependencies.sh)
models/

# OSM extracts and graph built from them (mapmatch/fetch_map.py) — downloaded, not committed
maps/

# Course book build (cd docs/book && jupyter-book build .)
docs/book/_build/
docs/book_ru/_build/
docs/_site/

# Editor / OS / toolchain caches
*~
*.swp
.DS_Store
.tools/

# Root-level PlotJuggler / analysis dumps
/*.csv
/*.json

# Ad-hoc plot output from the analysis scripts (--plot out.png)
out.png

app/src/main/cpp/third_party/*
app/src/main/cpp/clang_errors.txt

# Generated at build time from the root NOTICE (app/build.gradle: syncNotice)
app/src/main/assets/NOTICE.txt

# Recording archives pulled from the phone by hand — same rule as adas_logs/
/REC_*.tar.gz

# YOLO weights are Ultralytics AGPL derivatives — never committed (THIRD_PARTY.md); pushed to the
# device or synced from models/ at build time instead.
app/src/main/assets/traffic_yolo.onnx
